{
  "schemaVersion": 1,
  "id": "moe-utils",
  "version": "${version}",
  "name": "Moe Utils",
  "description": "Minecraft mapart utilities, with a printer forked from Vali's.",
  "authors": [
    "qnx"
  ],
  "contact": {
    "source": "https://github.com/qnxt/moe-utils"
  },
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "sh.qnx.moe.MoeUtils"
    ]
  },
  "mixins": [
    "litematica_moe-utils.mixins.json"
  ],
  "accessWidener": "moe-utils.accesswidener",
  "custom": {
    "meteor-client:color": "147,244,249"
  },
  "depends": {
    "java": ">=25",
    "minecraft": "${version}",
    "meteor-client": "*"
  }
}
