{
  "schemaVersion": 1,
  "id": "moe-utils",
  "version": "${version}",
  "name": "Moe Utils",
  "description": "Minecraft mapart utilities, with a printer forked from Vali's.",
  "authors": [
    "Kyuunex"
  ],
  "contact": {
    "email": "kyuunex@protonmail.ch",
    "repo": "https://github.com/Kyuunex/moe-utils"
  },
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "moe.utils.MoeUtils"
    ]
  },
  "mixins": [
    "litematica_moe-utils.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "147,244,249"
  },
  "depends": {
    "java": ">=21",
    "minecraft": "${mc_version}",
    "meteor-client": "*"
  }
}
